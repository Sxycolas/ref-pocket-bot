# Copie ce fichier en .env et remplis-le (le .env n'est jamais commité).
# Sur GitHub Actions, ces valeurs viennent des secrets REF_EMAIL / REF_PASS.
REF_EMAIL=ton.email@exemple.com
REF_PASS=ton_mot_de_passe
# Pour duels.mjs seulement : un second compte Ref Pocket qui sert d'adversaire.
# Sur GitHub Actions : secrets BOT_EMAIL / BOT_PASS.
BOT_EMAIL=email.du.bot@exemple.com
BOT_PASS=mot_de_passe_du_bot
